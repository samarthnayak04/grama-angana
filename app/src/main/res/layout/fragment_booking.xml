<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📝 Book the Hall"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"
            android:padding="8dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/input_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your Name"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/input_purpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Purpose (e.g., Wedding, Sports Practice)"
            android:inputType="text"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/input_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Date (YYYY-MM-DD)"
            android:inputType="text"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/input_start_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start Time (e.g., 9:00 AM)"
            android:inputType="text"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/input_end_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="End Time (e.g., 4:00 PM)"
            android:inputType="text"
            android:padding="14dp"
            android:background="@android:drawable/edit_text"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_ai_suggest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Get AI Suggestion"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/ai_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#424242"
            android:padding="8dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Booking Request"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2E7D32"
            android:padding="14dp"/>

    </LinearLayout>
</ScrollView>